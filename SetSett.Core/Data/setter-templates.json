{
  "version": 1,
  "templates": [
    {
      "name": "Keep awake while rendering",
      "description": "Click before a long render or build. Stops once the CPU has been quiet for 5 minutes.",
      "definition": {
        "id": "template.keep-awake",
        "name": "Keep awake while busy",
        "glyph": "\uE9F5",
        "changes": [
          {
            "settingId": "keepawake",
            "value": {
              "type": "choice",
              "id": "system"
            }
          }
        ],
        "start": "Manual",
        "enabled": true,
        "match": "All",
        "when": [],
        "until": [
          {
            "kind": "cpuQuiet",
            "percent": 10,
            "minutes": 5,
            "not": false
          }
        ],
        "putBack": true,
        "showInFlyout": true,
        "showTrayIcon": false,
        "activeLook": {
          "glyph": null,
          "color": "Taskbar",
          "dim": false,
          "bar": true
        },
        "inactiveLook": {
          "glyph": null,
          "color": "Taskbar",
          "dim": true,
          "bar": false
        },
        "indicator": "None",
        "trayIconId": 0,
        "timerChoices": [ 15, 30, 60, 120, 240, 360, 480 ]
      }
    },
    {
      "name": "Dark mode at night",
      "description": "Switches Windows and apps to dark between sunset and sunrise.",
      "definition": {
        "id": "template.dark-at-night",
        "name": "Dark at night",
        "glyph": "\uE708",
        "changes": [
          {
            "settingId": "theme.windows",
            "value": {
              "type": "choice",
              "id": "dark"
            }
          },
          {
            "settingId": "theme.apps",
