              "type": "choice",
              "id": "dark"
            }
          }
        ],
        "start": "Automatic",
        "enabled": true,
        "match": "All",
        "when": [
          {
            "kind": "sun",
            "phase": "Night",
            "sunriseOffsetMinutes": 0,
            "sunsetOffsetMinutes": 0,
            "not": false
          }
        ],
        "until": [],
