<?xml version="1.0" encoding="utf-8"?>
<ex:WindowEx
    x:Class="SetSett.Views.EditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ex="using:WinUIEx"
    Title="Setters">

    <ex:WindowEx.SystemBackdrop>
        <MicaBackdrop />
    </ex:WindowEx.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="Setters">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/StoreLogo.png" />
            </TitleBar.IconSource>
        </TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Setter list  -->
            <Grid Padding="12,4,12,12" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!--  The 4 px side margins match ListViewItem's inset, so the button and the list share their edges.  -->
                <DropDownButton
                    x:Name="NewButton"
                    Margin="4,0"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="New setter">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                        <TextBlock Text="New setter" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="NewMenu" Placement="BottomEdgeAlignedLeft" />
                    </DropDownButton.Flyout>
                </DropDownButton>
                <ListView
                    x:Name="SetterList"
                    Grid.Row="1"
                    AutomationProperties.Name="Setters"
                    SelectionChanged="SetterList_SelectionChanged"
                    SelectionMode="Single" />
                <!--  Sized and padded like a list item, so its icon and label line up with the setters above.  -->
                <Button
                    x:Name="SettingsLink"
                    Grid.Row="2"
                    MinHeight="40"
                    Margin="4,0"
                    Padding="12,0,12,0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    AutomationProperties.Name="Settings"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="SettingsLink_Click">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Grid Width="20">
                            <FontIcon FontSize="18" Glyph="&#xE713;" />
                            <InfoBadge
                                x:Name="UpdateBadge"
                                Margin="0,-4,-6,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Style="{StaticResource AttentionDotInfoBadgeStyle}"
                                Visibility="Collapsed" />
                        </Grid>
                        <TextBlock VerticalAlignment="Center" Text="Settings" />
                    </StackPanel>
                </Button>
            </Grid>

            <!--  Editor for the selected setter  -->
            <Border
                x:Name="EditorHost"
                Grid.Column="1"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,1,0,0"
                CornerRadius="8,0,0,0">
                <TextBlock
                    x:Name="NothingSelected"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Pick a setter, or create a new one." />
            </Border>
        </Grid>
    </Grid>
</ex:WindowEx>
