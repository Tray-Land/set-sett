<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SetSett.Views.FlyoutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid Padding="16,12,12,16">
    <Grid x:Name="MainPanel" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="TitleText"
                VerticalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Set Sett" />
            <Button
                Grid.Column="1"
                AutomationProperties.Name="New setter"
                Click="NewButton_Click"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="New setter">
                <FontIcon FontSize="14" Glyph="&#xE710;" />
            </Button>
            <Button
                Grid.Column="2"
                AutomationProperties.Name="Edit setters"
                Click="EditButton_Click"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Edit setters">
                <FontIcon FontSize="14" Glyph="&#xE70F;" />
            </Button>
            <Button
                Grid.Column="3"
                AutomationProperties.Name="Settings"
                Click="SettingsButton_Click"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Settings">
                <FontIcon FontSize="14" Glyph="&#xE713;" />
            </Button>
        </Grid>

        <!--  A setting Windows refused to change  -->
        <InfoBar
            x:Name="StatusBar"
            Grid.Row="1"
            IsClosable="True"
            IsOpen="False"
            Severity="Warning" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel x:Name="SetterList" Spacing="4" />

                <!--  Empty: a sentence and one next step  -->
                <StackPanel
                    x:Name="EmptyState"
                    Margin="0,48,0,0"
                    HorizontalAlignment="Center"
                    Spacing="12"
                    Visibility="Collapsed">
                    <FontIcon
                        FontSize="32"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE713;" />
                    <TextBlock
                        MaxWidth="260"
                        HorizontalTextAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Setters change Windows settings for you: with a click, on a timer, or on their own when something happens."
                        TextWrapping="Wrap" />
                    <Button
                        HorizontalAlignment="Center"
                        Click="NewButton_Click"
                        Content="Create a setter"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>

                <!--  Setters exist but none is shown: disabled, or hidden from the flyout  -->
                <StackPanel
                    x:Name="NoneShownState"
                    Margin="0,48,0,0"
                    HorizontalAlignment="Center"
                    Spacing="12"
                    Visibility="Collapsed">
                    <TextBlock
                        MaxWidth="260"
                        HorizontalTextAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Your setters are disabled or hidden from this flyout."
                        TextWrapping="Wrap" />
                    <Button
                        HorizontalAlignment="Center"
                        Click="EditButton_Click"
                        Content="Open the editor" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>

    <!--  Settings page: replaces the list until Back; built on demand, dropped when the flyout hides  -->
    <Grid
        x:Name="SettingsPanel"
        RowSpacing="12"
        Visibility="Collapsed">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                AutomationProperties.Name="Back"
                Click="BackButton_Click"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Back">
                <FontIcon FontSize="14" Glyph="&#xE72B;" />
            </Button>
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Settings" />
        </Grid>
        <ContentPresenter x:Name="SettingsHost" Grid.Row="1" />
    </Grid>
    </Grid>
</Page>
