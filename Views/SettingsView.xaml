<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SetSett.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    DragOver="SettingsView_DragOver"
    Drop="SettingsView_Drop">

    <!--  Shared by the flyout (a page) and the editor window (footer link). No chrome of its own.  -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            x:Name="Root"
            Padding="0,0,4,16"
            Spacing="4">
            <TextBlock
                Margin="0,0,0,8"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="General" />

            <!--  Settings card pattern without the Toolkit dependency  -->
            <Grid
                Padding="16,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                ColumnSpacing="12"
                CornerRadius="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Start with Windows" />
                    <TextBlock
                        x:Name="StartupDescription"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Keep the tray icon ready after you sign in."
                        TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch
                    x:Name="StartupToggle"
                    Grid.Column="1"
                    MinWidth="0"
                    Margin="0,0,-12,0"
                    AutomationProperties.Name="Start with Windows"
                    IsEnabled="False"
                    OffContent=""
                    OnContent=""
                    Toggled="StartupToggle_Toggled" />
            </Grid>

            <TextBlock
                Margin="0,20,0,8"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Location" />
            <Border
                Padding="16,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <StackPanel Spacing="8">
                    <TextBlock Text="Your location, for sunrise and sunset" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Pick your city from the built-in list, or use your location once. Set Sett keeps only the place you choose."
                        TextWrapping="Wrap" />
                    <ContentPresenter x:Name="LocationHost" />
                    <TextBlock
                        x:Name="LocationAccessText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap" />
                    <HyperlinkButton
                        Padding="0"
                        Click="LocationPrivacy_Click"
                        Content="Location privacy settings" />
                </StackPanel>
            </Border>

            <StackPanel x:Name="SetterFilesSection">
                <TextBlock
                    Margin="0,20,0,8"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Setter files" />
                <Border
                    Padding="16,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Import or export setters" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Drop .sett files here, or use Import to share one setter or move your complete collection."
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                AutomationProperties.Name="Import .sett file"
                                Click="ImportSett_Click"
                                Content="Import..." />
                            <Button
                                x:Name="ExportAllButton"
                                AutomationProperties.Name="Export all setters"
                                Click="ExportAll_Click"
                                Content="Export all" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <TextBlock
                Margin="0,20,0,8"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Diagnostics" />
            <Border
                Padding="16,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <StackPanel Spacing="12">
                    <StackPanel>
                        <TextBlock Text="Troubleshooting log" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Set Sett keeps a small log on this PC of what it set and put back, and anything that went wrong. It is never sent anywhere. Copy it into a bug report if something misbehaves."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            AutomationProperties.Name="Copy diagnostics"
                            Click="CopyDiagnostics_Click"
                            Content="Copy diagnostics" />
                        <Button
                            AutomationProperties.Name="Capture system state"
                            Click="CaptureState_Click"
                            Content="Capture system state" />
                        <Button
                            AutomationProperties.Name="Open logs folder"
                            Click="OpenLogs_Click"
                            Content="Open logs folder" />
                        <Button
                            AutomationProperties.Name="Clear logs"
                            Click="ClearLogs_Click"
                            Content="Clear logs" />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="VerboseToggle"
                        MinWidth="0"
                        AutomationProperties.Name="Detailed logging"
                        Header="Detailed logging"
                        OffContent="Off"
                        OnContent="On (sensor reports, timings; turn off when done)"
                        Toggled="VerboseToggle_Toggled" />
                    <InfoBar
                        x:Name="DiagnosticsInfoBar"
                        IsClosable="True"
                        IsOpen="False" />
                </StackPanel>
            </Border>

            <TextBlock
                Margin="0,20,0,8"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="About" />
            <TextBlock x:Name="VersionText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
