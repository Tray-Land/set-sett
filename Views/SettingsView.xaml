<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SetSett.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Shared by the flyout (a page) and the editor window (footer link). No chrome of its own.  -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="0,0,4,16" Spacing="4">
            <TextBlock
                Margin="0,0,0,8"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="General" />

            <!--  Settings card pattern without the Toolkit dependency  -->
            <Grid
                Padding="16,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                ColumnSpacing="12"
                CornerRadius="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Start with Windows" />
                    <TextBlock
                        x:Name="StartupDescription"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Keep the tray icon ready after you sign in."
                        TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch
                    x:Name="StartupToggle"
                    Grid.Column="1"
                    MinWidth="0"
                    AutomationProperties.Name="Start with Windows"
                    IsEnabled="False"
                    OffContent=""
                    OnContent=""
                    Toggled="StartupToggle_Toggled" />
            </Grid>

            <TextBlock
                Margin="0,20,0,8"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Location" />
            <Border
                Padding="16,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <StackPanel Spacing="8">
                    <TextBlock Text="Your location, for sunrise and sunset" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Pick your city from the built-in list, or use your location once. Set Sett keeps only the place you choose."
                        TextWrapping="Wrap" />
                    <ContentPresenter x:Name="LocationHost" />
                    <TextBlock
                        x:Name="LocationAccessText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap" />
                    <HyperlinkButton
                        Padding="0"
                        Click="LocationPrivacy_Click"
                        Content="Location privacy settings" />
                </StackPanel>
            </Border>

            <TextBlock
                Margin="0,20,0,8"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="About" />
            <TextBlock x:Name="VersionText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
